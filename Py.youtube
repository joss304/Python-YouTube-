import yt_dlp
import os
import shutil
import glob

def mover_archivos_a_musica(patron_busqueda, carpeta_destino="~/storage/music"):
    """
    Busca archivos que coincidan con el patrón y los mueve a la carpeta de música.
    """
    carpeta_destino = os.path.expanduser(carpeta_destino)  # Convierte ~/ en la ruta absoluta
    if not os.path.exists(carpeta_destino):
        os.makedirs(carpeta_destino)  # Crea la carpeta si no existe

    # Buscar archivos que coincidan con el patrón
    archivos_descargados = glob.glob(patron_busqueda)

    for archivo in archivos_descargados:
        if os.path.exists(archivo):
            shutil.move(archivo, os.path.join(carpeta_destino, os.path.basename(archivo)))
            print(f"Archivo movido: {archivo} -> {carpeta_destino}")
        else:
            print(f"Archivo no encontrado: {archivo}")

def descargar_video(urls):
    # Configuración para descargar video
    opciones_video = {
        'format': 'best',  # Descarga el mejor formato disponible
        'outtmpl': '%(title)s.%(ext)s',  # Nombre del archivo
    }

    with yt_dlp.YoutubeDL(opciones_video) as ydl:
        ydl.download(urls)
        print("¡Descarga de videos completada!")

        mover_archivos_a_musica("*.mp4", "~/storage/dcim/Camera")

def descargar_musica(urls):
    # Configuración para descargar solo audio (MP3)
    opciones_audio = {
        'format': 'bestaudio/best',  # Mejor calidad de audio
        'outtmpl': '%(title)s.%(ext)s',  # Nombre del archivo
        'postprocessors': [{  # Convertir a MP3
            'key': 'FFmpegExtractAudio',
            'preferredcodec': 'mp3',
            'preferredquality': '192',
        }],
        'ffmpeg_location': '/data/data/com.termux/files/usr/bin/ffmpeg',  # Ruta de ffmpeg
    }

    with yt_dlp.YoutubeDL(opciones_audio) as ydl:
        ydl.download(urls)
        print("¡Descarga de música completada!")

        # Mover archivos descargados (busca archivos .mp3)
        mover_archivos_a_musica("*.mp3")

def main():
    print("1. Descargar video")
    print("2. Descargar música (MP3)")
    opcion = input("Elige una opción (1 o 2): ")

    urls = []
    for i in range(10):
        url = input(f"Ingresa la URL de YouTube {i+1} (o deja en blanco para terminar): ")
        if url.strip() == "":
            break
        urls.append(url)

    if not urls:
        print("No se ingresaron URLs.")
        return

    if opcion == "1":
        descargar_video(urls)
    elif opcion == "2":
        descargar_musica(urls)
    else:
        print("Opción no válida.")

if __name__ == "__main__":
    main()
